# Copy this file to .env.local (app runtime) and fill in real values.
# DATABASE_URL goes in .env instead (Prisma convention) — see README.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=              # generate with: openssl rand -base64 32
CMS_API_URL=http://localhost:1337
# Paystack dashboard → Settings → API Keys & Webhooks. Add a webhook pointing
# at https://<your-domain>/api/payments/webhook with this same secret key —
# that's what turns a successful checkout into a Booking automatically.
PAYSTACK_SECRET_KEY=
# PayPal REST app credentials (developer.paypal.com → Apps & Credentials).
# Live app only — this integration always calls api-m.paypal.com, there is
# no sandbox mode wired in. PayPal doesn't support KES, so every PayPal
# charge on this site is in USD (see BookEntry.priceUsd in src/lib/data/books.ts).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PESAPAL_CONSUMER_KEY=
RESEND_API_KEY=
# CRM outbound channels remain disabled until official provider credentials and
# approved templates are configured. Never put these values in source control.
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCESS_TOKEN=
# Not used yet — PayPal confirmation currently relies on capturing the order
# directly on the buyer's return trip (see src/app/api/books/verify-paypal),
# which needs no webhook. Set this only if a PayPal webhook subscription is
# added later for extra confirmation.
PAYPAL_WEBHOOK_ID=
# Directory holding the actual book PDFs for instant-download purchases.
# Never served statically — every read goes through the paid, token-gated
# /api/books/download route. Defaults to ./Books (gitignored) for local dev.
# In production, point this at a path outside the git checkout entirely.
BOOKS_STORAGE_DIR=
# Directory holding downloadable Parental Guidance lesson resources
# (worksheets, planners, checklists). Never served statically: every read
# goes through the enrollment/membership-gated /api/courses/lessons/[id]/
# resource route. Defaults to ./CourseResources (gitignored) for local dev.
# In production, point this at a path outside the git checkout entirely.
COURSE_RESOURCES_STORAGE_DIR=
# Directory holding self-hosted course/masterclass lesson video files, the
# protected replacement for a public iframe embed URL. Never served
# statically: every read goes through the enrollment/membership-gated
# /api/courses/lessons/[id]/video route, with the same Range-streaming
# access check on every request as a teaching video. Defaults to
# ./CourseVideos (gitignored) for local dev. In production, point this at
# a path outside the git checkout entirely.
COURSE_VIDEOS_STORAGE_DIR=
# Whole-site kill switch, for the developer (not the client) to take the
# site fully offline on non-payment and bring it back once paid. See
# src/middleware.ts and scripts/toggle-site.js. Unset/anything other than
# the exact string "true" means live, so never set this unless you mean it.
APP_SUSPENDED=
# Long random secret (e.g. `openssl rand -base64 32`) letting the developer
# view the live site via ?bypass=<token> while APP_SUSPENDED=true hides it
# from everyone else. Leave unset and the bypass simply never matches.
SUSPENSION_BYPASS_TOKEN=
# platform.openai.com → API keys. Powers the "Generate with AI" button on
# coaching category card images (/dashboard/admin/coaching). Admin-only,
# never called from a public route; every call costs real money on this
# key's account. Unset means that button returns a clear "not configured"
# error instead of failing silently; nothing else on the site depends on it.
OPENAI_API_KEY=
