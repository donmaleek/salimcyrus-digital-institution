# book PDFs — private, paid-download content; never belongs in git (binaries,
# 150MB+). Lives in BOOKS_STORAGE_DIR outside the repo in production. See README.
/Books/

# Generated coaching category card images: reproducible output of
# scripts/generate-coaching-category-images.js, not source. Lives in
# COACHING_IMAGES_STORAGE_DIR outside the repo in production.
/CoachingImages/

# Generated Parental Guidance lesson resource PDFs: reproducible output of
# scripts/seed-parental-guidance.js, not source. Lives in
# COURSE_RESOURCES_STORAGE_DIR outside the repo in production.
/CourseResources/

# Self-hosted course/masterclass lesson video files: admin-uploaded,
# private, paid/enrollment-gated content; never belongs in git. Lives in
# COURSE_VIDEOS_STORAGE_DIR outside the repo in production.
/CourseVideos/

# Paid teaching videos and payment-claim evidence: private, never in git.
# Live in TEACHINGS_STORAGE_DIR / PAYMENT_EVIDENCE_STORAGE_DIR in production.
/Teachings/
/PaymentEvidence/
